{
  "name": "cv-editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:verify": "bun run scripts/verify-database.ts",
    "icons:generate": "bun run scripts/generate-icons.ts",
    "icons:check": "bun run icons:generate && git diff --exit-code -- src/ui/icons/generated src/ui/icons/index.ts src/ui/icons/catalog.ts",
    "test:unit": "bun test tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.4",
    "@lexical/history": "^0.51.0",
    "@lexical/link": "0.51.0",
    "@lexical/list": "^0.51.0",
    "@lexical/react": "^0.51.0",
    "@lexical/rich-text": "0.51.0",
    "@lexical/selection": "0.51.0",
    "@lexical/utils": "^0.51.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.16",
    "drizzle-orm": "^0.45.3",
    "lexical": "^0.51.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@next/env": "16.3.5",
    "@playwright/test": "^1.63.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "svgo": "^4.1.0",
    "typescript": "^5"
  },
  "packageManager": "bun@1.2.20",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
